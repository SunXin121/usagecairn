# Vercel project environment (server only):
# ACCESS_KEY — your private access key: tt_ + 64 lowercase hex characters.
# Generate one with:  printf 'tt_%s\n' "$(openssl rand -hex 32)"
# Uploads and the dashboard both authenticate with this single key; the server
# only ever sees its SHA-256 digest. Rotating it means editing this variable.
# DATABASE_URL is NOT set manually — attach the PostgreSQL database through
# Vercel Storage (Marketplace integration, e.g. Neon) and it is injected
# automatically for the server functions.
ACCESS_KEY=tt_REPLACE_WITH_openssl_rand_hex_32

# Collector overrides (your local machine). Prefer persisting them once with:
#   node bin/token-pulse.js connect --api-url https://your-project.vercel.app --key tt_...
# which writes ~/.token-pulse/tracker/upload.json (mode 600) so background
# hook-spawned syncs upload without any shell profile. Env wins when both exist.
TOKEN_PULSE_API_URL=https://your-project.vercel.app
TOKEN_PULSE_ACCESS_KEY=tt_SAME_KEY_AS_THE_SERVER_ACCESS_KEY_ABOVE
