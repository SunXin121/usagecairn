# Vercel project environment (server only — both must be set):
# PostgreSQL connection string, ideally the pooled URL from your integration.
DATABASE_URL=postgresql://user:password@localhost:5432/tokentracker
# Your private access key: tt_ + 64 lowercase hex characters.
# Generate one with:  printf 'tt_%s\n' "$(openssl rand -hex 32)"
# Uploads and the dashboard both authenticate with this single key; the server
# only ever sees its SHA-256 digest. Rotating it means editing this variable.
TOKENTRACKER_ACCESS_KEY=tt_REPLACE_WITH_openssl_rand_hex_32

# Collector overrides. Prefer persisting them once with:
#   node bin/tracker.js connect --api-url https://your-project.vercel.app --key tt_...
# which writes ~/.tokentracker/tracker/upload.json (mode 600) so background
# hook-spawned syncs upload without any shell profile. Env wins when both exist.
TOKENTRACKER_API_URL=https://your-project.vercel.app
TOKENTRACKER_ACCESS_KEY=tt_SAME_KEY_AS_THE_SERVER_VARIABLE_ABOVE
