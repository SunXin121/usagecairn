{
  "name": "usagecairn",
  "version": "1.0.0",
  "description": "Local AI token usage collector with a PostgreSQL-backed web dashboard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SunXin121/usagecairn.git"
  },
  "homepage": "https://github.com/SunXin121/usagecairn#readme",
  "bugs": {
    "url": "https://github.com/SunXin121/usagecairn/issues"
  },
  "keywords": [
    "tokens",
    "usage",
    "claude-code",
    "codex",
    "dashboard",
    "postgresql",
    "vercel"
  ],
  "main": "src/cli.js",
  "bin": {
    "usagecairn": "bin/usagecairn.js"
  },
  "files": [
    "bin/",
    "src/",
    "LICENSE",
    "README.md"
  ],
  "type": "commonjs",
  "scripts": {
    "test": "node --test test/*.test.js",
    "ci:local": "npm test && npm run dashboard:test && npm run dashboard:build",
    "dashboard:test": "npm --prefix dashboard test",
    "dashboard:build": "npm --prefix dashboard run build",
    "dashboard:dev": "npm --prefix dashboard run dev",
    "dashboard:preview": "npm --prefix dashboard run preview",
    "pricing:build-seed": "node scripts/build-pricing-seed.cjs"
  },
  "dependencies": {
    "@mongodb-js/zstd": "^2.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "pg": "^8.16.3"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
